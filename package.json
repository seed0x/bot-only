{
  "name": "bot-only",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--experimental-sqlite next dev",
    "build": "NODE_OPTIONS=--experimental-sqlite next build",
    "start": "NODE_OPTIONS=--experimental-sqlite next start",
    "lint": "eslint",
    "seed": "node --experimental-sqlite --experimental-strip-types scripts/seed.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --experimental-sqlite --experimental-transform-types --test tests/*.test.mjs",
    "machine": "node scripts/machine.mjs",
    "smoke:gate": "node scripts/gate-smoke.mjs",
    "prestart": "node --experimental-sqlite --experimental-strip-types scripts/db-check.mjs",
    "predev": "node --experimental-sqlite --experimental-strip-types scripts/db-check.mjs",
    "db:check": "node --experimental-sqlite --experimental-strip-types scripts/db-check.mjs",
    "db:reset": "node --experimental-sqlite scripts/db-reset.mjs"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
